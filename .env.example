# Copy to .env and fill in. Never commit .env.
#
# With none of these set, Hydrogen falls back to mock.shop and renders against
# generic sample products. To point at the real store you need the two PUBLIC_
# storefront values below; everything else is optional.

# Signs the session cookie. Any non-empty string locally; a real secret in prod.
SESSION_SECRET=

# ── Storefront API ────────────────────────────────────────────────────────────
# The store. This one is public — it appears in every Storefront API request.
PUBLIC_STORE_DOMAIN=smsg1t-j1.myshopify.com

# Public Storefront API access token. Create it in Shopify admin:
#   Settings → Apps and sales channels → Develop apps → Create an app
#   → Configure Storefront API scopes → tick at minimum:
#       unauthenticated_read_product_listings
#       unauthenticated_read_product_inventory
#       unauthenticated_write_checkouts / unauthenticated_read_checkouts
#   → Install app → copy the Storefront API access token
# Then publish the products to that app's sales channel, or the API returns
# nothing: admin → each product → Publishing → add the channel.
PUBLIC_STOREFRONT_API_TOKEN=

# Optional. Used for Shopify analytics attribution only.
PUBLIC_STOREFRONT_ID=
PUBLIC_CHECKOUT_DOMAIN=

# ── Customer Account API ──────────────────────────────────────────────────────
# Only needed for the /account routes. From the Headless or Hydrogen channel.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=

# Server-side token, if the storefront is password protected.
PRIVATE_STOREFRONT_API_TOKEN=
