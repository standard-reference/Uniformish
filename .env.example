# Copy to .env and fill in. Never commit .env.
#
# Local dev works without a real storefront: with no Shopify credentials set,
# Hydrogen falls back to mock.shop so the site renders against sample products.
# Run `npx shopify hydrogen link` then `npx shopify hydrogen env pull` to inject
# the real values once the store exists.

# Signs the session cookie. Any non-empty string locally; a real secret in prod.
SESSION_SECRET=

# Storefront API. From Shopify admin → Settings → Apps → Develop apps.
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=
PUBLIC_CHECKOUT_DOMAIN=

# Customer Account API, for the /account routes.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=

# Server-side Storefront token, if the storefront is password protected.
PRIVATE_STOREFRONT_API_TOKEN=
