node_modules

# Build output
/dist
/build
/.cache
/.mf
*.tsbuildinfo

# React Router generated route types (rebuilt by `npm run typecheck`)
/.react-router

# Local environment. Never commit a real storefront token or session secret —
# .env.example carries the key names with empty values and is the only one
# that gets committed.
.env
.env.*
!.env.example

# Shopify CLI
.shopify

# Editor / OS
.DS_Store
.idea/
.vscode/

# Local Claude Code settings (machine-specific, not shared)
.claude/settings.local.json
