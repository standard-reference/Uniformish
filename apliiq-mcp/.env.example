# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Both values come from the Apliiq dashboard:
#   Account -> Stores -> Add a Custom Store
# They cannot be generated through the API. No custom store, no credentials.

# The API Key shown on the custom store. Sent in the clear, in the Authorization header.
APLIIQ_APP_ID=

# The shared secret for the custom store. This is an HMAC key, NOT a bearer token —
# it is never transmitted, only used to sign. It must never reach client-side code,
# a browser bundle, a log, or this repo.
APLIIQ_SHARED_SECRET=

# Optional. Defaults to https://api.apliiq.com/v1 when unset.
APLIIQ_BASE_URL=https://api.apliiq.com/v1

# Optional. Per-request timeout in milliseconds. Defaults to 30000.
APLIIQ_TIMEOUT_MS=30000
